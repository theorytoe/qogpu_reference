with "config/qogpu_reference_config.gpr";
project Qogpu_Reference is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Qogpu_Reference_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("qogpu_reference.adb");

   package Compiler is
      for Default_Switches ("Ada") use Qogpu_Reference_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Qogpu_Reference;
